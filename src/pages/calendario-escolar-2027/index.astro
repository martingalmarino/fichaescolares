---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ListaFeriados from '../../components/ListaFeriados.astro';
import Preguntas from '../../components/Preguntas.astro';
import { calendarioDe } from '../../data/calendario-escolar';
import { provincias } from '../../data/provincias';
import { feriadosDelAnio } from '../../lib/calendario';
import { metaCalendarioEscolar, nombreCalendario } from '../../lib/meta';
import { faqJsonLd, itemListJsonLd } from '../../lib/seo';
import {
	LEY_FERIADOS,
	actualizadoVisible,
	confirmadas,
	fechaActualizado,
	fechaTarjeta,
	notaPuentes,
	preguntasNacional,
	rangoTarjeta,
	textoPlano,
} from '../../lib/texto-calendario';
import BaseLayout from '../../layouts/BaseLayout.astro';

const calendario = calendarioDe(2027);
const anio = calendario.anio;
const meta = metaCalendarioEscolar(anio);
const actualizado = actualizadoVisible(calendario);
const preguntas = preguntasNacional(calendario);
const sitio = Astro.site ?? new URL('https://www.aulita.com.ar');
const url = new URL(meta.ruta, sitio).href;
const filas = provincias
	.map((provincia) => ({ provincia, jurisdiccion: calendario.jurisdicciones[provincia.slug]! }))
	.sort((a, b) => a.provincia.slug.localeCompare(b.provincia.slug, 'es'));
const oficiales = confirmadas(calendario);
const feriados = feriadosDelAnio(anio);
const lista = itemListJsonLd(
	`Calendario escolar ${anio} por provincia`,
	filas.map((fila) => ({
		name: nombreCalendario(fila.provincia),
		url: new URL(`/calendario-escolar-${anio}/${fila.provincia.slug}/`, sitio).href,
	})),
);
const faq = faqJsonLd(preguntas.map((item) => ({ q: item.q, a: textoPlano(item.a) })));
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			name: meta.title,
			url,
			inLanguage: 'es-AR',
			dateModified: actualizado,
			isPartOf: { '@id': 'https://www.aulita.com.ar/#website' },
			about: { '@type': 'Country', name: 'Argentina' },
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', sitio).href },
				{ '@type': 'ListItem', position: 2, name: `Calendario escolar ${anio}`, item: url },
			],
		},
		{ '@type': 'FAQPage', mainEntity: faq.mainEntity },
		{ '@type': 'ItemList', name: lista.name, numberOfItems: lista.numberOfItems, itemListElement: lista.itemListElement },
	],
};
---

<BaseLayout title={meta.title} description={meta.description} image={`/og/calendario-escolar-${anio}.svg`} jsonLd={jsonLd}>
	<article class="mx-auto max-w-6xl px-4 py-8">
		<Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: `Calendario escolar ${anio}` }]} />
		<h1 class="mt-4 text-3xl font-bold tracking-tight text-azul sm:text-4xl">Calendario escolar {anio} en Argentina, por provincia</h1>
		<p class="mt-3 max-w-3xl text-base leading-relaxed text-texto">
			{
				oficiales === 0
					? `Ninguna provincia publicó todavía su calendario escolar ${anio}. Acá vas a ver inicio de clases, vacaciones de invierno y fin del ciclo de las 24 jurisdicciones a medida que salgan las fechas oficiales.`
					: `${oficiales} de 24 jurisdicciones ya publicaron el calendario escolar ${anio}. En el resto, el inicio de clases, las vacaciones de invierno y el fin del ciclo siguen a confirmar.`
			}
		</p>
		<p class="mt-2 text-sm text-muted">
			Actualizado el <time datetime={actualizado}>{fechaActualizado(actualizado)}</time>
			<span aria-hidden="true"> · </span>
			{oficiales} de 24 provincias con calendario oficial
		</p>
		<h2 class="mt-10 text-2xl font-bold tracking-tight text-azul">Fechas clave por provincia</h2>
		<ul class="no-print mt-4 grid gap-3 lg:hidden">
			{
				filas.map((fila) => (
					<li class="rounded-card border border-borde bg-white p-4">
						<a class="text-base font-semibold text-azul hover:text-celeste" href={`/calendario-escolar-${anio}/${fila.provincia.slug}/`}>
							{nombreCalendario(fila.provincia)}
						</a>
						<dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
							<div>
								<dt class="text-xs font-semibold uppercase tracking-wide text-muted">Inicio</dt>
								<dd class="mt-1 text-azul">{fechaTarjeta(fila.jurisdiccion.inicio)}</dd>
							</div>
							<div>
								<dt class="text-xs font-semibold uppercase tracking-wide text-muted">Fin</dt>
								<dd class="mt-1 text-azul">{fechaTarjeta(fila.jurisdiccion.fin)}</dd>
							</div>
							<div class="col-span-2">
								<dt class="text-xs font-semibold uppercase tracking-wide text-muted">Vacaciones de invierno</dt>
								<dd class="mt-1 text-azul">{rangoTarjeta(fila.jurisdiccion.invierno.desde, fila.jurisdiccion.invierno.hasta)}</dd>
							</div>
							<div>
								<dt class="text-xs font-semibold uppercase tracking-wide text-muted">Estado</dt>
								<dd class="mt-1">
									<span class:list={['inline-flex rounded-full px-2 py-0.5 text-xs font-medium', fila.jurisdiccion.estado === 'oficial' ? 'bg-celeste-50 text-celeste' : 'bg-sol-50 text-sol']}>
										{fila.jurisdiccion.estado === 'oficial' ? 'oficial' : 'a confirmar'}
									</span>
								</dd>
							</div>
						</dl>
					</li>
				))
			}
		</ul>
		<div class="tabla-provincias mt-4 hidden overflow-x-auto rounded-card border border-borde bg-white lg:block">
			<table class="w-full text-left text-sm">
				<thead class="bg-celeste-50 text-azul">
					<tr>
						<th class="px-4 py-3 font-semibold">Provincia</th>
						<th class="px-4 py-3 font-semibold">Inicio</th>
						<th class="px-4 py-3 font-semibold">Vacaciones de invierno</th>
						<th class="px-4 py-3 font-semibold">Fin</th>
						<th class="px-4 py-3 font-semibold">Estado</th>
					</tr>
				</thead>
				<tbody>
					{
						filas.map((fila) => (
							<tr class="border-t border-borde">
								<th class="px-4 py-3 font-medium" scope="row">
									<a class="inline-flex min-h-11 items-center text-azul hover:text-celeste hover:underline" href={`/calendario-escolar-${anio}/${fila.provincia.slug}/`}>
										{nombreCalendario(fila.provincia)}
									</a>
								</th>
								<td class="px-4 py-3">{fechaTarjeta(fila.jurisdiccion.inicio)}</td>
								<td class="px-4 py-3">{rangoTarjeta(fila.jurisdiccion.invierno.desde, fila.jurisdiccion.invierno.hasta)}</td>
								<td class="px-4 py-3">{fechaTarjeta(fila.jurisdiccion.fin)}</td>
								<td class="px-4 py-3">
									<span class:list={['inline-flex rounded-full px-2 py-0.5 text-xs font-medium', fila.jurisdiccion.estado === 'oficial' ? 'bg-celeste-50 text-celeste' : 'bg-sol-50 text-sol']}>
										{fila.jurisdiccion.estado === 'oficial' ? 'oficial' : 'a confirmar'}
									</span>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<section id="feriados" class="mt-12">
			<h2 class="text-2xl font-bold tracking-tight text-azul">Feriados nacionales {anio}</h2>
			<p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted">
				Los fija la <a class="text-celeste underline" href={LEY_FERIADOS} rel="noopener">Ley 27.399</a>. Cada fecha abre su ficha en las <a class="text-celeste underline" href="/efemerides/">efemérides</a>.
			</p>
			{notaPuentes(anio) && <p class="mt-1 max-w-3xl text-sm leading-relaxed text-muted">{notaPuentes(anio)}</p>}
			<ListaFeriados feriados={feriados} />
		</section>
		<section class="mt-12 max-w-3xl">
			<h2 class="text-2xl font-bold tracking-tight text-azul">¿Quién define el calendario escolar?</h2>
			<p class="mt-3 text-base leading-relaxed text-texto">
				El calendario escolar lo define el ministerio de educación de cada provincia y de la Ciudad de Buenos Aires. El Consejo Federal de Educación fija pautas comunes, como los 190 días de clase. Las resoluciones suelen publicarse entre noviembre y febrero, y esta página pasa cada jurisdicción a oficial cuando hay una fuente para citar.
			</p>
		</section>
		<Preguntas preguntas={preguntas} />
	</article>
</BaseLayout>
