---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { provincias } from '../../data/provincias';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Fichas por provincia para imprimir | Aulita"
	description="Fichas provinciales para imprimir, con silueta para colorear, capital y datos para completar."
>
	<article class="mx-auto max-w-6xl px-4 py-8">
		<Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Provincias' }]} />
		<h1 class="mt-4 text-3xl font-bold tracking-tight text-azul sm:text-4xl">Fichas por provincia</h1>
		<p class="mt-3 max-w-3xl leading-relaxed text-muted">
			Cada ficha trae la silueta para colorear, la capital para marcar y los datos para completar. La flor, el árbol, la bandera y el escudo se suman cuando tienen fuente.
		</p>
		{
			provincias.length > 0 && (
				<ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
					{provincias.map((provincia) => (
						<li>
							<a class="block rounded-card border border-borde bg-white p-4 shadow-card hover:border-celeste" href={`/provincias/${provincia.slug}/`}>
								<img class="h-24 w-full object-contain" src={provincia.silueta} alt="" />
								<h2 class="mt-3 font-semibold text-azul">{provincia.nombre}</h2>
								{provincia.capital && <p class="mt-1 text-sm text-muted">Capital: {provincia.capital}</p>}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</article>
</BaseLayout>
