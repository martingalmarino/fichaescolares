---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TarjetaMapa from '../../components/TarjetaMapa.astro';
import { mapasDeProvincia } from '../../data/mapas';
import { provincias, type Provincia } from '../../data/provincias';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { semillaDeFicha, sopaDeFicha } from '../../lib/sopa-ficha';

export function getStaticPaths() {
	return provincias.map((provincia) => ({
		params: { slug: provincia.slug },
		props: { provincia },
	}));
}

interface Props {
	provincia: Provincia;
}

interface Pieza {
	etiqueta: string;
	nombre: string;
	src?: string;
}

const { provincia } = Astro.props;
const mapasProvincia = mapasDeProvincia(provincia.slug);
const sopa = provincia.palabras ? sopaDeFicha(provincia.palabras, semillaDeFicha(provincia.slug)) : null;
const piezas: Pieza[] = [];
if (provincia.bandera) piezas.push({ etiqueta: '', nombre: 'Bandera', src: provincia.bandera.src });
if (provincia.escudo) piezas.push({ etiqueta: '', nombre: 'Escudo', src: provincia.escudo.src });
if (provincia.flor) piezas.push({ etiqueta: 'Flor', nombre: provincia.flor });
if (provincia.arbol) piezas.push({ etiqueta: 'Árbol', nombre: provincia.arbol });
const nombres = [...piezas].reverse().map((pieza) => pieza.nombre);
const actividades = ['Coloreá la silueta.'];
if (provincia.capital) actividades.push('Marcá la capital.');
if (piezas.length > 1) actividades.push('Uní cada símbolo con su nombre.');
actividades.push('Completá los datos.');
if (sopa) actividades.push('Encontrá las ocho palabras en la sopa.');
const datos = [
	provincia.capital ? ['Capital', provincia.capital] : null,
	provincia.region ? ['Región', provincia.region] : null,
	['Superficie', provincia.superficie],
	['Población', provincia.poblacion],
	provincia.flor ? ['Flor', provincia.flor] : null,
	provincia.arbol ? ['Árbol', provincia.arbol] : null,
].filter((dato): dato is [string, string] => Boolean(dato));
const descripcion = provincia.capital
	? `Ficha de ${provincia.nombre} para imprimir. Capital: ${provincia.capital}.`
	: `Ficha de ${provincia.nombre} para imprimir.`;
---

<BaseLayout title={`${provincia.nombre}: ficha para imprimir | Aulita`} description={descripcion}>
	<article class="mx-auto max-w-3xl px-4 py-8">
		<Breadcrumbs
			items={[
				{ label: 'Inicio', href: '/' },
				{ label: 'Provincias', href: '/provincias/' },
				{ label: provincia.nombre },
			]}
		/>
		<div class="no-print mt-4 flex flex-wrap gap-2">
			<button id="imprimir-ficha" type="button" class="rounded-control bg-sol px-4 py-2.5 text-sm font-semibold text-azul">Imprimir</button>
			<a class="rounded-control border border-borde px-4 py-2.5 text-sm" href="/provincias/">Volver al índice</a>
		</div>
		<div class="a4 mt-6 min-w-0 rounded-card border border-borde bg-white p-4 text-azul shadow-card sm:p-6">
			<p class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
				<span>Nombre: ______________________________</span>
				<span>Fecha: ___/___/______</span>
			</p>
			<h1 class="mt-3 text-3xl font-bold">{provincia.nombre}</h1>
			<img class="mx-auto mt-4 h-auto w-full max-w-[90mm]" src={provincia.silueta} alt={`Silueta de ${provincia.nombre}`} />
			<dl class="mt-4 grid gap-2 text-base sm:grid-cols-2">
				{datos.map(([etiqueta, valor]) => (
					<div><dt class="font-semibold">{etiqueta}</dt><dd>{valor}</dd></div>
				))}
			</dl>
			<h2 class="mt-6 text-xl font-bold">Actividades</h2>
			<ol class="mt-2 list-decimal space-y-2 pl-5 text-sm leading-relaxed">
				{actividades.map((actividad) => <li>{actividad}</li>)}
			</ol>
			{
				piezas.length > 1 && (
					<div class="mt-4 grid gap-4 sm:grid-cols-2">
						<ul class="space-y-3">
							{piezas.map((pieza, indice) => (
								<li class="flex h-16 items-center justify-center rounded-control border border-borde p-2 font-semibold">
									{pieza.src ? <img class="max-h-14 max-w-full" src={pieza.src} alt={`Símbolo ${indice + 1}`} /> : pieza.etiqueta}
								</li>
							))}
						</ul>
						<ul class="space-y-3 text-sm">
							{nombres.map((nombre) => <li class="flex h-16 items-center rounded-control border border-dashed border-borde px-3">{nombre}</li>)}
						</ul>
					</div>
				)
			}
			<ul class="mt-4 space-y-2 text-sm">
				{datos.map(([etiqueta]) => <li class="break-words">{etiqueta}: ______________________________</li>)}
			</ul>
			<p class="pie-hoja">aulita.com.ar</p>
			{
				sopa && (
					<section class="solutions mt-8">
						<h2 class="text-xl font-bold">Sopa de letras</h2>
						<p class="mt-1 text-sm">{provincia.palabras?.join(' · ')}</p>
						<div
							class="mx-auto mt-3 grid w-full min-w-0 max-w-[150mm] gap-px"
							style={`grid-template-columns: repeat(${sopa.grid.length}, minmax(0, 1fr))`}
						>
							{sopa.grid.flat().map((letra) => (
								<span class="flex aspect-square min-w-0 items-center justify-center border border-borde text-[10px] font-semibold leading-none">{letra}</span>
							))}
						</div>
						<p class="pie-hoja">aulita.com.ar</p>
					</section>
				)
			}
		</div>
		<section class="no-print mt-8 text-sm leading-relaxed text-muted">
			<h2 class="text-lg font-semibold text-azul">Fuentes</h2>
			<ul class="mt-2 space-y-1">
				{provincia.fuentes.map((fuente) => (
					<li><a class="text-celeste underline" href={fuente}>{fuente}</a></li>
				))}
			</ul>
			{
				provincia.normas.length > 0 && (
					<ul class="mt-3 space-y-1">
						{provincia.normas.map((norma) => <li>{norma}</li>)}
					</ul>
				)
			}
			{provincia.bandera && (
				<p class="mt-3">
					Bandera: {provincia.bandera.licencia}. <a class="text-celeste underline" href={provincia.bandera.pagina}>{provincia.bandera.pagina}</a>
				</p>
			)}
			{provincia.escudo && (
				<p class="mt-1">
					Escudo: {provincia.escudo.licencia}. <a class="text-celeste underline" href={provincia.escudo.pagina}>{provincia.escudo.pagina}</a>
				</p>
			)}
			<p class="mt-1">
				Silueta: Natural Earth, dominio público. El detalle está en <a class="text-celeste underline" href="/creditos/">Créditos</a>.
			</p>
			<h2 class="mt-8 text-lg font-semibold text-azul">Cómo usar la ficha de {provincia.nombre}</h2>
			<p class="mt-2">
				Imprimila en A4. La silueta se colorea{provincia.capital ? ' y la capital se marca sobre ese contorno' : ''}. Los renglones de abajo se completan con los datos de la ficha.
			</p>
		</section>
		{
			mapasProvincia.length > 0 && (
				<section class="no-print mt-10">
					<h2 class="text-2xl font-bold tracking-tight text-azul">Mapas de {provincia.nombre} para imprimir</h2>
					<p class="mt-2 text-sm leading-relaxed text-muted">Láminas del Instituto Geográfico Nacional, en PDF, para imprimir en A4.</p>
					<ul class="mt-4 grid gap-4 sm:grid-cols-2">
						{mapasProvincia.map((mapa) => (
							<li>
								<TarjetaMapa mapa={mapa} />
							</li>
						))}
					</ul>
				</section>
			)
		}
	</article>
</BaseLayout>

<script define:vars={{ titulo: provincia.nombre }}>
	document.getElementById('imprimir-ficha')?.addEventListener('click', () => {
		const anterior = document.title;
		document.title = titulo;
		const restaurar = () => {
			document.title = anterior;
			window.removeEventListener('afterprint', restaurar);
		};
		window.addEventListener('afterprint', restaurar);
		window.print();
	});
</script>
