---
import Anuncio from '../components/Anuncio.astro';
import AvisoCalificacion from '../components/AvisoCalificacion.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Preguntas from '../components/Preguntas.astro';
import CalculadoraPromedio from '../islands/CalculadoraPromedio';
import { CALIFICACION_ACTUALIZADO, preguntasCalculadora } from '../data/calificacion-primaria';
import BaseLayout from '../layouts/BaseLayout.astro';
import { metaEstaticas } from '../lib/meta';
import { paginaCalificacionJsonLd } from '../lib/seo';

const meta = metaEstaticas.calculadoraPromedio;
const h1 = 'Calculadora de promedio escolar para primaria';
const migas = [
	{ name: 'Inicio', url: '/' },
	{ name: 'Cómo se califica', url: '/como-se-califica-en-primaria/' },
	{ name: 'Calculadora', url: meta.ruta },
];
---

<BaseLayout
	title={meta.title}
	description={meta.description}
	keywords="calcular promedio escolar, calculadora de promedio primaria, promedio de notas primaria, con cuanto se aprueba"
	image="/og/calificacion-promedio.svg"
	jsonLd={paginaCalificacionJsonLd({
		tipo: 'WebApplication',
		nombre: h1,
		descripcion: meta.description,
		ruta: meta.ruta,
		actualizado: CALIFICACION_ACTUALIZADO,
		migas,
		preguntas: preguntasCalculadora,
	})}
>
	<article class="mx-auto max-w-3xl px-4 py-8 text-base leading-relaxed">
		<Breadcrumbs items={migas.map((item) => ({ label: item.name, href: item.url === meta.ruta ? undefined : item.url }))} />
		<h1 class="mt-4 text-3xl font-bold tracking-tight text-azul sm:text-4xl">{h1}</h1>
		<AvisoCalificacion />
		<p class="mt-4">
			Cargá las notas y elegí la provincia. Si la escala publicada es numérica, la calculadora muestra el promedio y si llega a la nota de aprobación. Si es conceptual, muestra los conceptos en lugar de un número.
		</p>
		<Anuncio />
		<div class="mt-6">
			<CalculadoraPromedio client:visible />
		</div>
		<h2 class="mt-8 text-2xl font-bold text-azul">Seguir leyendo</h2>
		<ul class="mt-3 list-disc space-y-2 pl-5">
			<li><a class="text-celeste underline" href="/como-se-califica-en-primaria/">Cómo se califica en cada provincia</a></li>
			<li><a class="text-celeste underline" href="/como-se-califica-en-primaria/provincia-de-buenos-aires/">Provincia de Buenos Aires</a></li>
			<li><a class="text-celeste underline" href="/como-se-califica-en-primaria/caba/">Ciudad de Buenos Aires</a></li>
		</ul>
		<AvisoCalificacion modo="cierre" />
		<Preguntas preguntas={preguntasCalculadora} />
	</article>
</BaseLayout>
