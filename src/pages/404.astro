---
import BaseLayout from '../layouts/BaseLayout.astro';
import { metaEstaticas } from '../lib/meta';
---

<BaseLayout title={metaEstaticas.noEncontrada.title} description={metaEstaticas.noEncontrada.description} noindex>
	<section class="mx-auto max-w-3xl px-4 py-16">
		<h1 class="text-3xl font-bold text-azul">No encontramos esa página</h1>
		<p class="mt-4 leading-relaxed text-muted">El enlace puede estar viejo. Volvé al inicio o entrá a un generador.</p>
		<ul class="mt-6 space-y-2 text-celeste">
			<li><a class="hover:underline" href="/">Inicio</a></li>
			<li><a class="hover:underline" href="/sopa-de-letras/">Sopa de letras</a></li>
			<li><a class="hover:underline" href="/provincias/">Provincias</a></li>
			<li><a class="hover:underline" href="/guia-para-el-aula/">Guía para el aula</a></li>
		</ul>
	</section>
</BaseLayout>
