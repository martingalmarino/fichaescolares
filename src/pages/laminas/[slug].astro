---
import Anuncio from '../../components/Anuncio.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TarjetaLamina from '../../components/TarjetaLamina.astro';
import HojaLamina from '../../islands/HojaLamina';
import { fechasDe, laminaPorSlug, nombreCategoria, publicadas, relacionadas } from '../../data/laminas';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	return publicadas.map((lamina) => ({
		params: { slug: lamina.slug },
		props: { slug: lamina.slug },
	}));
}

interface Props {
	slug: string;
}

const lamina = laminaPorSlug(Astro.props.slug);
if (!lamina) throw new Error(`Lámina no publicada: ${Astro.props.slug}`);
const otras = relacionadas(lamina);
const fechas = fechasDe(lamina);
const sitio = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(`/laminas/${lamina.slug}/`, sitio).href;
const imagen = new URL(lamina.svg, sitio).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CreativeWork',
			name: lamina.titulo,
			url,
			educationalUse: 'Lámina para colorear',
			isAccessibleForFree: true,
			audience: [
				{ '@type': 'EducationalAudience', educationalRole: 'teacher' },
				{ '@type': 'PeopleAudience', audienceType: 'Familias' },
			],
			image: {
				'@type': 'ImageObject',
				contentUrl: imagen,
				name: lamina.titulo,
				description: lamina.alt,
				encodingFormat: 'image/svg+xml',
				creditText: 'Aulita',
				isAccessibleForFree: true,
			},
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', sitio).href },
				{ '@type': 'ListItem', position: 2, name: 'Láminas para colorear', item: new URL('/laminas/', sitio).href },
				{ '@type': 'ListItem', position: 3, name: lamina.titulo, item: url },
			],
		},
	],
};
---

<BaseLayout title={`${lamina.titulo} para colorear e imprimir | Aulita`} description={lamina.alt} image="/og/laminas.svg" jsonLd={jsonLd}>
	<article class="mx-auto max-w-6xl px-4 py-8">
		<Breadcrumbs
			items={[
				{ label: 'Inicio', href: '/' },
				{ label: 'Láminas para colorear', href: '/laminas/' },
				{ label: lamina.titulo },
			]}
		/>
		<h1 class="no-print mt-4 text-3xl font-bold tracking-tight text-azul sm:text-4xl">{lamina.titulo} para colorear</h1>
		<p class="no-print mt-3 max-w-3xl text-sm text-muted">
			{nombreCategoria(lamina.categoria)}. Cambiá el título y la consigna en la hoja. Para el PDF, tocá Descargar PDF y elegí “Guardar como PDF”.
		</p>
		<div class="mt-6">
			<HojaLamina
				client:load
				slug={lamina.slug}
				categoria={lamina.categoria}
				tituloInicial={lamina.titulo}
				alt={lamina.alt}
				svg={lamina.svg}
				ancho={lamina.ancho}
				alto={lamina.alto}
			/>
		</div>

		<section class="no-print mx-auto mt-12 max-w-3xl text-base leading-relaxed text-texto">
			<h2 class="text-2xl font-bold tracking-tight text-azul">Cómo usarla en el aula</h2>
			<p class="mt-4">
				Imprimí una hoja por estudiante, en blanco y negro. Antes de colorear, nombrá lo que se ve y dejá que el grupo diga de qué fecha se trata. El título y la consigna de arriba se pueden cambiar para la actividad del día.
			</p>
			<p class="mt-4">
				El dibujo es una actividad de lápiz. No reemplaza la bandera, el sol ni ningún símbolo oficial: si hace falta el color reglamentario, mostralo aparte y decilo en voz alta.
			</p>
		</section>

		<Anuncio slot={import.meta.env.PUBLIC_ADSENSE_SLOT_LAMINA} />

		{
			otras.length > 0 && (
				<section class="no-print mt-10">
					<h2 class="text-xl font-bold text-azul">Otras láminas</h2>
					<ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
						{otras.map((otra) => (
							<li>
								<TarjetaLamina lamina={otra} />
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			fechas.length > 0 && (
				<section class="no-print mt-10 max-w-3xl text-sm leading-relaxed">
					<h2 class="text-xl font-bold text-azul">Para seguir con esta fecha</h2>
					<ul class="mt-3 space-y-2">
						{fechas.map((fecha) => (
							<li>
								{fecha.ficha ? (
									<a class="text-celeste hover:underline" href={fecha.ficha}>
										Ficha del {fecha.etiqueta}
									</a>
								) : (
									<span>{fecha.etiqueta}</span>
								)}
								{fecha.sopa && (
									<>
										{' · '}
										<a class="text-celeste hover:underline" href={fecha.sopa}>
											Sopa de letras
										</a>
									</>
								)}
							</li>
						))}
					</ul>
				</section>
			)
		}
	</article>
</BaseLayout>
