---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Preguntas from '../components/Preguntas.astro';
import {
	parrafosPlanificador,
	pasosPlanificador,
	preguntasPlanificador,
	respuestaPlanificador,
	seoPlanificador,
} from '../data/planificador-contenido';
import PlanificadorGenerator from '../islands/PlanificadorGenerator.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import { metaEstaticas } from '../lib/meta';
import { etiquetasJsonLd } from '../lib/seo';

const meta = metaEstaticas.planificador;
const migas = [
	{ name: 'Inicio', url: '/' },
	{ name: 'Generadores', url: '/#generadores' },
	{ name: 'Planificador docente 2027', url: meta.ruta },
];
---

<BaseLayout
	title={meta.title}
	description={meta.description}
	keywords={seoPlanificador.keywords}
	jsonLd={etiquetasJsonLd({
		nombre: 'Planificador docente 2027',
		descripcion: meta.description,
		ruta: meta.ruta,
		migas,
		preguntas: preguntasPlanificador,
		pasos: pasosPlanificador,
	})}
>
	<article class="mx-auto max-w-7xl px-4 py-8">
		<div class="no-print">
			<Breadcrumbs
				items={[
					{ label: 'Inicio', href: '/' },
					{ label: 'Generadores', href: '/#generadores' },
					{ label: 'Planificador docente 2027' },
				]}
			/>
			<h1 class="mt-4 text-3xl font-bold tracking-tight text-azul sm:text-4xl">{seoPlanificador.h1}</h1>
			<p class="mt-3 max-w-3xl text-base leading-relaxed text-muted">{respuestaPlanificador}</p>
		</div>

		<div class="mt-6">
			<PlanificadorGenerator client:idle />
		</div>

		<section class="no-print mx-auto mt-12 max-w-3xl text-base leading-relaxed text-texto">
			<p class="mt-4" set:html={parrafosPlanificador[0]} />
			<h2 class="mt-8 text-2xl font-bold tracking-tight text-azul">Cómo se calculan los días hábiles</h2>
			{
				parrafosPlanificador.slice(1).map((parrafo) => (
					<p class="mt-4" set:html={parrafo} />
				))
			}
		</section>
		<div class="no-print mx-auto max-w-3xl">
			<Preguntas preguntas={preguntasPlanificador} />
		</div>
	</article>
</BaseLayout>
