---
import AvisoCalificacion from '../../components/AvisoCalificacion.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FichaProvincia from '../../components/FichaProvincia.astro';
import Preguntas from '../../components/Preguntas.astro';
import {
	CALIFICACION_ACTUALIZADO,
	NORMA_NACIONAL,
	jurisdiccionesCalificacion,
	jurisdiccionesHub,
	jurisdiccionesSinDatos,
	preguntasHub,
	urlFichaProvincia,
} from '../../data/calificacion-primaria';
import { calendarioVigente } from '../../data/calendario-escolar';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { metaEstaticas } from '../../lib/meta';
import { paginaCalificacionJsonLd } from '../../lib/seo';

const meta = metaEstaticas.calificacion;
const h1 = 'Cómo se califica en la escuela primaria en Argentina';
const migas = [
	{ name: 'Inicio', url: '/' },
	{ name: 'Cómo se califica', url: meta.ruta },
];
const sitio = 'https://www.aulita.com.ar';
const conEscala = jurisdiccionesHub('escala');
const conConceptos = jurisdiccionesHub('conceptos');
const sinDatos = jurisdiccionesSinDatos();
const grupos = [
	{ titulo: 'Con escala publicada', items: conEscala },
	{ titulo: 'Solo con conceptos', items: conConceptos },
	{ titulo: 'Sin datos oficiales publicados', items: sinDatos },
];
const keywords = [
	'cómo se califica en primaria',
	'con cuánto se aprueba en primaria',
	...conEscala.map((item) => `escala de notas primaria ${item.nombre.toLocaleLowerCase('es-AR')}`),
	'como se califica en primaria argentina',
	'calificaciones primaria',
	'notas primaria 2026',
	'boletín primaria',
].join(', ');
const listaEscala = conEscala.map((item) => ({
	name: item.nombre,
	url: urlFichaProvincia(item, sitio, meta.ruta),
}));
---

<BaseLayout
	title={meta.title}
	description={meta.description}
	keywords={keywords}
	image="/og/calificacion.svg"
	jsonLd={paginaCalificacionJsonLd({
		tipo: 'Article',
		nombre: h1,
		descripcion: meta.description,
		ruta: meta.ruta,
		actualizado: CALIFICACION_ACTUALIZADO,
		migas,
		preguntas: preguntasHub,
		dataset: {
			name: 'Escalas de calificación de primaria por provincia',
			description: 'Escala del primer ciclo, escala del segundo ciclo, nota de aprobación y norma citada para cada jurisdicción.',
		},
		lista: listaEscala,
	})}
>
	<article class="mx-auto max-w-[1100px] px-4 py-8 text-base leading-relaxed">
		<Breadcrumbs items={migas.map((item) => ({ label: item.name, href: item.url === meta.ruta ? undefined : item.url }))} />
		<h1 class="mt-4 text-3xl font-bold tracking-tight text-azul sm:text-4xl">{h1}</h1>
		<AvisoCalificacion />
		<p class="mt-4 max-w-3xl text-muted">
			En Argentina no hay una escala única: cada provincia define la suya. En los primeros grados casi todas usan conceptos, y desde 4.º muchas pasan a números del 1 al 10. Según la provincia, se aprueba con 6 o con 7.
		</p>

		<ul class="mt-5 grid list-none gap-3 p-0 md:grid-cols-3">
			<li class="rounded-card bg-celeste-50 p-4">
				<p class="m-0 text-[17px] font-bold leading-snug text-azul">Se aprueba con 6 o con 7</p>
				<p class="m-0 mt-1 text-sm leading-snug text-[#374151]">Depende de la provincia. No hay nota nacional.</p>
			</li>
			<li class="rounded-card bg-celeste-50 p-4">
				<p class="m-0 text-[17px] font-bold leading-snug text-azul">Conceptos primero, números después</p>
				<p class="m-0 mt-1 text-sm leading-snug text-[#374151]">Muchas provincias pasan al 1 a 10 desde 4.º grado.</p>
			</li>
			<li class="rounded-card bg-celeste-50 p-4">
				<p class="m-0 text-[17px] font-bold leading-snug text-azul">1.º no se repite</p>
				<p class="m-0 mt-1 text-sm leading-snug text-[#374151]">
					1.º y 2.º son unidad pedagógica ({NORMA_NACIONAL}).{' '}
					<a
						class="relative inline-block font-semibold text-azul underline underline-offset-2 after:absolute after:-inset-x-1 after:-inset-y-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azul"
						href="/como-se-califica-en-primaria/se-repite-primer-grado/"
					>
						Ver nota
					</a>
				</p>
			</li>
		</ul>

		<div class="sticky top-[69px] z-30 -mx-4 bg-bg px-4 py-2 lg:top-[77px]">
			<div class="flex flex-col gap-2.5 rounded-card bg-celeste-50 p-3 sm:flex-row sm:items-center">
				<label class="sr-only" for="ir-provincia">Elegí tu provincia</label>
				<select
					id="ir-provincia"
					class="min-h-11 w-full flex-1 rounded-control border border-celeste-100 bg-white px-3 text-azul focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azul"
				>
					<option value="">Elegí tu provincia…</option>
					{
						grupos.map((grupo) => (
							<optgroup label={grupo.titulo}>
								{grupo.items.map((item) => (
									<option value={item.slug}>{item.nombre}</option>
								))}
							</optgroup>
						))
					}
				</select>
				<a
					class="inline-flex min-h-11 items-center justify-center rounded-control bg-azul px-4 font-semibold text-white no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
					href="/calculadora-promedio-primaria/"
				>
					Calcular promedio
				</a>
			</div>
		</div>

		<h2 id="con-escala" class="mt-8 text-2xl font-bold text-azul">Provincias con escala publicada</h2>
		<p class="m-0 mt-1 text-[15px] text-muted">
			{conEscala.length} de {jurisdiccionesCalificacion.length} jurisdicciones publican nota de aprobación.
		</p>
		<p class="m-0 mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
			<span>
				<span class="mr-1.5 inline-block h-2.5 w-3.5 rounded-sm bg-sol-50 align-middle shadow-[inset_0_-3px_0_#f4a531]" aria-hidden="true"></span>
				Notas con las que se aprueba
			</span>
			<span>Borde celeste = tiene guía completa</span>
		</p>
		<ul class="m-0 mt-4 grid list-none gap-3.5 p-0" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,330px),1fr))" aria-labelledby="con-escala">
			{conEscala.map((item) => <FichaProvincia item={item} />)}
		</ul>

		<h2 id="solo-conceptos" class="mt-10 text-2xl font-bold text-azul">Solo con conceptos</h2>
		<p class="m-0 mt-1 text-[15px] text-muted">Publican escala conceptual, sin nota numérica de aprobación en esta ficha.</p>
		<ul class="m-0 mt-4 grid list-none gap-3.5 p-0" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,330px),1fr))" aria-labelledby="solo-conceptos">
			{conConceptos.map((item) => <FichaProvincia item={item} />)}
		</ul>

		<h2 id="sin-datos" class="mt-10 text-2xl font-bold text-azul">Sin datos oficiales publicados</h2>
		<p class="m-0 mt-1 text-[15px] text-muted">{sinDatos.length} jurisdicciones. Consultá en la escuela.</p>
		<ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0" aria-labelledby="sin-datos">
			{
				sinDatos.map((item) => (
					<li id={item.slug} class="max-w-full scroll-mt-56 rounded-full border border-dashed border-[#d1d5db] px-3 py-1.5 text-sm text-muted min-[700px]:scroll-mt-44">
						{item.nombre}
					</li>
				))
			}
		</ul>

		<div class="mt-10 flex flex-col gap-4 rounded-card bg-azul p-5 text-white sm:flex-row sm:items-center sm:justify-between">
			<div>
				<p class="m-0 text-lg font-bold">Calculadora de promedio de primaria</p>
				<p class="m-0 mt-1 text-celeste-50">Cargá las notas de cada período y te da el promedio.</p>
			</div>
			<a
				class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-control bg-sol px-4 font-bold text-azul no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
				href="/calculadora-promedio-primaria/"
			>
				Calcular promedio
			</a>
		</div>
		<ul class="m-0 mt-3.5 grid list-none gap-3 p-0 md:grid-cols-3">
			<li>
				<a
					class="flex min-h-11 items-center rounded-card border border-borde bg-white p-3.5 font-semibold text-azul no-underline hover:border-celeste focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azul"
					href="/como-se-califica-en-primaria/como-leer-el-boletin/"
				>
					Cómo leer el boletín →
				</a>
			</li>
			<li>
				<a
					class="flex min-h-11 items-center rounded-card border border-borde bg-white p-3.5 font-semibold text-azul no-underline hover:border-celeste focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azul"
					href="/como-se-califica-en-primaria/se-repite-primer-grado/"
				>
					¿Se repite primer grado? →
				</a>
			</li>
			<li>
				<a
					class="flex min-h-11 items-center rounded-card border border-borde bg-white p-3.5 font-semibold text-azul no-underline hover:border-celeste focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azul"
					href={`/calendario-escolar-${calendarioVigente.anio}/`}
				>
					Calendario escolar {calendarioVigente.anio} →
				</a>
			</li>
		</ul>
		<AvisoCalificacion modo="cierre" />
		<div class="max-w-3xl">
			<Preguntas preguntas={preguntasHub} />
		</div>
	</article>
	<script is:inline type="module">
		const select = document.getElementById('ir-provincia');
		if (select instanceof HTMLSelectElement) {
			select.addEventListener('change', () => {
				const id = select.value;
				if (!id) return;
				const destino = document.getElementById(id);
				if (!destino) return;
				const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				destino.scrollIntoView({ behavior: reducir ? 'auto' : 'smooth', block: 'start' });
				history.replaceState(null, '', `#${id}`);
			});
		}
	</script>
</BaseLayout>
