---
import HeroEscritorio from '../components/HeroEscritorio.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { calendarioVigente } from '../data/calendario-escolar';
import { efemerides } from '../data/efemerides';
import ProximasEfemerides from '../islands/ProximasEfemerides';
import { proximasEfemerides } from '../lib/calendario';
import BaseLayout from '../layouts/BaseLayout.astro';

const proximas = proximasEfemerides(efemerides, new Date(), 4);

const generadores = [
	{
		nombre: 'Planificador docente 2027',
		texto: 'Meses con feriados, días hábiles, planificación anual y asistencia.',
		icon: 'planificador' as const,
		href: '/planificador-docente-2027/',
	},
	{
		nombre: 'Agenda docente 2027',
		texto: 'Portada, meses, semana a semana, cumpleaños y asistencia.',
		icon: 'agenda' as const,
		href: '/agenda-docente-2027/',
	},
	{
		nombre: 'Planificación anual',
		texto: 'Áreas por trimestre o cuatrimestre, con los días hábiles de tu provincia.',
		icon: 'planificacion' as const,
		href: '/planificacion-anual/',
	},
	{
		nombre: 'Registro de asistencia',
		texto: 'Planilla por mes, con los días hábiles de tu provincia y tu lista de alumnos.',
		icon: 'asistencia' as const,
		href: '/registro-de-asistencia/',
	},
	{
		nombre: 'Sopa de letras',
		texto: 'Por efeméride, con 3 niveles de dificultad y soluciones.',
		icon: 'sopa' as const,
		href: '/sopa-de-letras/',
	},
	{
		nombre: 'Crucigrama de próceres',
		texto: 'Pistas automáticas sobre San Martín, Belgrano, Sarmiento y más.',
		icon: 'crucigrama' as const,
		href: '/crucigrama-proceres/',
	},
	{
		nombre: 'Caligrafía',
		texto: 'Cursiva e imprenta, con trazos y textos propios.',
		icon: 'caligrafia' as const,
		href: '/caligrafia/',
	},
	{
		nombre: 'Ficha por provincia',
		texto: 'Silueta para colorear, capital y datos para completar.',
		icon: 'provincia' as const,
		href: '/provincias/',
	},
	{
		nombre: 'Láminas para colorear',
		texto: 'Dibujos en trazo para colorear e imprimir en A4.',
		icon: 'laminas' as const,
		href: '/laminas/',
	},
	{
		nombre: 'Mapas escolares para imprimir',
		texto: 'Mapas oficiales del IGN: Argentina, provincias, América y el mundo.',
		icon: 'mapas' as const,
		href: '/mapas/',
	},
	{
		nombre: 'Tablas y operaciones',
		texto: 'Cuentas aleatorias por nivel, con hoja de respuestas.',
		icon: 'tablas' as const,
		href: '/tablas-y-operaciones/',
	},
	{
		nombre: 'Etiquetas escolares',
		texto: 'Con nombre, para cuadernos, carpetas y útiles. Los datos no salen de tu compu.',
		icon: 'etiquetas' as const,
		href: '/etiquetas-escolares/',
	},
];

const preguntas: { q: string; a: string; abierta?: boolean; html?: string; qHtml?: string }[] = [
	{
		q: '¿Es gratis?',
		a: 'Sí. Todo Aulita es gratis y sin registro: fichas, mapas, láminas, el calendario escolar y el planificador docente.',
		abierta: true,
	},
	{
		q: '¿Qué puedo imprimir en Aulita?',
		a: 'Sopas de letras, crucigramas, caligrafía, ejercicios de matemática, láminas, mapas del IGN y fichas de efemérides. Para docentes, también el planificador, la agenda docente, la planificación anual y el registro de asistencia.',
	},
	{
		q: '¿Cómo lo guardo en PDF?',
		a: 'Tocá Descargar PDF. En los generadores de fichas, elegí "Guardar como PDF" como destino de impresión. Todo sale en A4.',
	},
	{
		q: '¿Sigue los contenidos de la escuela argentina?',
		a: 'Sí. Las fechas, el vocabulario y los próceres siguen el calendario escolar argentino: Revolución de Mayo, Independencia, Día de la Bandera y el resto de las efemérides.',
	},
	{
		q: '¿Dónde veo cuándo empiezan las clases en mi provincia?',
		a: 'En el calendario escolar 2027 hay una página por cada una de las 24 jurisdicciones con inicio, vacaciones de invierno y fin de clases. Lo actualizamos apenas cada provincia publica su calendario oficial.',
		html: 'En el <a class="text-celeste underline" href="/calendario-escolar-2027/">calendario escolar 2027</a> hay una página por cada una de las 24 jurisdicciones con inicio, vacaciones de invierno y fin de clases. Lo actualizamos apenas cada provincia publica su calendario oficial.',
	},
	{
		q: '¿El planificador docente trae las fechas de mi provincia?',
		qHtml:
			'¿El <a class="text-celeste underline" href="/planificador-docente-2027/">planificador docente</a> trae las fechas de mi provincia?',
		a: 'Sí. Elegís tu provincia y arma los meses con feriados, efemérides y días hábiles ya contados. Mientras la provincia no publique su calendario, las fechas figuran como provisorias.',
	},
	{
		q: '¿Puedo incluir la hoja de soluciones?',
		a: 'Sí. En la sopa de letras y en el crucigrama podés sumar la hoja de soluciones, que sale en una página aparte.',
	},
	{
		q: '¿Para quién es este sitio?',
		a: 'Para docentes de nivel inicial y primario, maestras particulares y familias. El sitio está pensado para adultos; las hojas se llevan al aula o a casa.',
	},
];

const checks = ['Formato A4', 'Con hoja de soluciones', 'Contenido argentino'];
---

<BaseLayout
	title="Aulita: imprimibles escolares de Argentina | Fichas, mapas y efemérides"
	description="Fichas, mapas del IGN, láminas y etiquetas con nombre para imprimir gratis en A4. Calendario de efemérides argentinas para docentes y familias."
	jsonLd={{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: preguntas.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	}}
>
	<section class="bg-celeste-50">
		<div
			class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:py-16"
		>
			<div>
				<h1
					class="mt-4 max-w-xl text-4xl font-bold leading-[1.15] tracking-tight text-azul sm:text-5xl"
				>
					Material escolar argentino para imprimir, listo en un minuto
				</h1>
				<p class="mt-4 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
					Fichas, mapas, láminas y etiquetas con nombre para el aula y la casa. Con el calendario
					de efemérides, los próceres y las provincias de Argentina. Gratis y en A4.
				</p>
				<div class="mt-6 flex flex-wrap items-center gap-3">
					<a
						href="/sopa-de-letras/"
						class="inline-flex items-center rounded-control bg-sol px-4 py-2.5 text-sm font-semibold text-azul shadow-sm transition hover:brightness-95"
					>
						Crear una ficha
					</a>
					<a
						href="/efemerides/"
						class="inline-flex items-center rounded-control border border-borde bg-white px-4 py-2.5 text-sm font-semibold text-texto shadow-sm transition hover:border-celeste-100"
					>
						Ver calendario escolar
					</a>
				</div>
				<ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted">
					{
						checks.map((item) => (
							<li class="inline-flex items-center gap-1.5">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 16 16"
									class="size-3.5 text-celeste"
									aria-hidden="true"
								>
									<path
										d="M3 8.2 6.2 11.5 13 4.5"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
								{item}
							</li>
						))
					}
				</ul>
			</div>

			<div class="mx-auto w-full lg:justify-self-end">
				<HeroEscritorio />
			</div>
		</div>
	</section>

	<section class="border-b border-borde bg-white">
		<div class="mx-auto max-w-6xl px-4 py-6">
			<a
				href="/mapas/"
				class="flex flex-col gap-4 rounded-card border border-celeste bg-celeste-50 p-5 shadow-card transition hover:border-azul sm:flex-row sm:items-center sm:justify-between"
			>
				<div class="flex items-start gap-4">
					<ToolIcon name="mapas" />
					<div>
						<h2 class="text-xl font-bold tracking-tight text-azul">Mapas escolares para imprimir</h2>
						<p class="mt-1 max-w-xl text-sm leading-relaxed text-muted">
							Mapas oficiales del Instituto Geográfico Nacional: Argentina, las 24 provincias, América y el mundo. Políticos, físicos, mudos y satelitales, listos para imprimir en A4.
						</p>
					</div>
				</div>
				<span class="inline-flex shrink-0 items-center justify-center rounded-control bg-sol px-4 py-2.5 text-sm font-semibold text-azul">Ver mapas</span>
			</a>
		</div>
	</section>

	<section class="border-b border-borde bg-white">
		<div class="mx-auto max-w-6xl px-4 py-6">
			<a
				href={`/calendario-escolar-${calendarioVigente.anio}/`}
				class="flex flex-col gap-4 rounded-card border border-borde bg-white p-5 shadow-card transition hover:border-celeste sm:flex-row sm:items-center sm:justify-between"
			>
				<div>
					<h2 class="text-xl font-bold tracking-tight text-azul">Calendario escolar {calendarioVigente.anio} por provincia</h2>
					<p class="mt-1 max-w-xl text-sm leading-relaxed text-muted">
						Inicio de clases, vacaciones de invierno y fin del ciclo de las 24 jurisdicciones. Las fechas se cargan cuando cada ministerio las publica.
					</p>
				</div>
				<span class="inline-flex shrink-0 items-center justify-center rounded-control bg-sol px-4 py-2.5 text-sm font-semibold text-azul">Ver calendario {calendarioVigente.anio}</span>
			</a>
		</div>
	</section>

	<section id="efemerides" class="scroll-mt-6">
		<div class="mx-auto max-w-6xl px-4 py-6">
			<h2 class="text-2xl font-bold tracking-tight text-azul">Próximas efemérides</h2>
			<p class="mt-2 text-muted">Elegí una fecha y generá fichas con su vocabulario.</p>
			<ProximasEfemerides client:load iniciales={proximas} todas={efemerides} cantidad={4} />
		</div>
	</section>

	<section id="generadores" class="scroll-mt-6">
		<div class="mx-auto max-w-6xl px-4 py-8">
			<h2 class="text-2xl font-bold tracking-tight text-azul">Generadores</h2>
			<p class="mt-2 text-muted">Todos imprimen en A4 y se pueden guardar como PDF.</p>
			<ul class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
				{
					generadores.map((herramienta) => (
						<li>
							<a
								href={herramienta.href}
								class="block h-full rounded-card border border-borde bg-white p-5 shadow-card transition hover:border-celeste"
							>
								<ToolIcon name={herramienta.icon} />
								<h3 class="mt-4 text-base font-semibold text-azul">{herramienta.nombre}</h3>
								<p class="mt-1 text-sm leading-relaxed text-muted">{herramienta.texto}</p>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-10" aria-labelledby="faq-titulo">
		<h2 id="faq-titulo" class="text-2xl font-bold tracking-tight text-azul">Preguntas frecuentes</h2>
		<p class="mt-2 text-muted">Lo que más nos consultan docentes y familias.</p>
		<div class="mt-6 overflow-hidden rounded-card border border-borde bg-white">
			{
				preguntas.map((item) => (
					<details class="group border-b border-borde last:border-b-0" open={item.abierta} data-q={item.q}>
						<summary class="flex cursor-pointer items-center gap-3 px-4 py-4 text-sm font-semibold text-azul sm:text-base">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 16 16"
								class="size-3.5 shrink-0 text-muted transition-transform group-open:rotate-90"
								aria-hidden="true"
							>
								<path d="M6 3.5 11 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							<span>
								{item.qHtml ? <Fragment set:html={item.qHtml} /> : item.q}
							</span>
						</summary>
						<p class="px-4 pb-4 pl-10 text-sm leading-relaxed text-muted" set:html={item.html ?? item.a} />
					</details>
				))
			}
		</div>
	</section>
</BaseLayout>
