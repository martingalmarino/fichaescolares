---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Preguntas from '../components/Preguntas.astro';
import {
	parrafosPlanificacion,
	pasosPlanificacion,
	preguntasPlanificacion,
	respuestaPlanificacion,
	seoPlanificacion,
} from '../data/planificador-contenido';
import PlanificacionGenerator from '../islands/PlanificacionGenerator.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import { metaEstaticas } from '../lib/meta';
import { etiquetasJsonLd } from '../lib/seo';

const meta = metaEstaticas.planificacion;
const migas = [
	{ name: 'Inicio', url: '/' },
	{ name: 'Generadores', url: '/#generadores' },
	{ name: 'Planificación anual', url: meta.ruta },
];
---

<BaseLayout
	title={meta.title}
	description={meta.description}
	keywords={seoPlanificacion.keywords}
	jsonLd={etiquetasJsonLd({
		nombre: 'Planificación anual',
		descripcion: meta.description,
		ruta: meta.ruta,
		migas,
		preguntas: preguntasPlanificacion,
		pasos: pasosPlanificacion,
	})}
>
	<article class="mx-auto max-w-7xl px-4 py-8">
		<div class="no-print">
			<Breadcrumbs
				items={[
					{ label: 'Inicio', href: '/' },
					{ label: 'Generadores', href: '/#generadores' },
					{ label: 'Planificación anual' },
				]}
			/>
			<h1 class="mt-4 text-3xl font-bold tracking-tight text-azul sm:text-4xl">{seoPlanificacion.h1}</h1>
			<p class="mt-3 max-w-3xl text-base leading-relaxed text-muted">{respuestaPlanificacion}</p>
		</div>

		<div class="mt-6">
			<PlanificacionGenerator client:visible />
		</div>

		<section class="no-print mx-auto mt-12 max-w-3xl text-base leading-relaxed text-texto">
			<p class="mt-4" set:html={parrafosPlanificacion[0]} />
			<h2 class="mt-8 text-2xl font-bold tracking-tight text-azul">Cómo repartir el año</h2>
			<p class="mt-4" set:html={parrafosPlanificacion[1]} />
			<h2 class="mt-8 text-2xl font-bold tracking-tight text-azul">Un ejemplo para primer grado</h2>
			{
				parrafosPlanificacion.slice(2).map((parrafo) => (
					<p class="mt-4" set:html={parrafo} />
				))
			}
		</section>
		<div class="no-print mx-auto max-w-3xl">
			<Preguntas preguntas={preguntasPlanificacion} />
		</div>
	</article>
</BaseLayout>
