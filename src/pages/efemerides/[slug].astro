---
import BloqueMes from '../../components/BloqueMes.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TarjetaLamina from '../../components/TarjetaLamina.astro';
import { efemerides, etiquetaFecha, nombreRegla, nombreTipo } from '../../data/efemerides';
import { laminasDeFecha } from '../../data/laminas';
import {
	MESES_SLUG,
	efemeridesCercanas,
	efemeridesDelMes,
	fechaArgentina,
	mesDeSlug,
	nombreMes,
	proximaOcurrencia,
	slugDeMes,
	textoFecha,
} from '../../lib/calendario';
import { eventoEfemeride, isoFecha, itemListJsonLd } from '../../lib/seo';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	const slugs = new Set(efemerides.map((fecha) => fecha.slug));
	const meses = MESES_SLUG.map((slug) => {
		if (slugs.has(slug)) throw new Error(`El mes «${slug}» pisa una efeméride`);
		return { params: { slug }, props: { slug, vista: 'mes' as const } };
	});
	const fechas = efemerides.map((fecha) => ({ params: { slug: fecha.slug }, props: { slug: fecha.slug, vista: 'fecha' as const } }));
	return [...meses, ...fechas];
}

interface Props {
	slug: string;
	vista: 'mes' | 'fecha';
}

const { slug, vista } = Astro.props;
const hoy = fechaArgentina(new Date());

const numeroMes = vista === 'mes' ? mesDeSlug(slug) : null;
if (vista === 'mes' && !numeroMes) throw new Error(`Mes desconocido: ${slug}`);
const anterior = numeroMes ? (numeroMes === 1 ? 12 : numeroMes - 1) : null;
const siguiente = numeroMes ? (numeroMes === 12 ? 1 : numeroMes + 1) : null;
const delMes = numeroMes ? efemeridesDelMes(efemerides, numeroMes, hoy.anio) : [];

const fecha = vista === 'fecha' ? efemerides.find((item) => item.slug === slug) : null;
if (vista === 'fecha' && !fecha) throw new Error(`Efeméride desconocida: ${slug}`);
const laminas = fecha && fecha.dia != null && fecha.mes != null ? laminasDeFecha(fecha.dia, fecha.mes) : [];
const proxima = fecha ? proximaOcurrencia(fecha, new Date()) : null;
const cercanas = fecha ? efemeridesCercanas(efemerides, fecha.slug, new Date()) : [];
const mesFicha = proxima?.mes ?? fecha?.mes ?? null;
const titulo = vista === 'mes' ? `${nombreMes(numeroMes ?? 1)} ${hoy.anio}` : (fecha?.nombre ?? '');
const descripcion = vista === 'mes' ? `Efemérides de ${nombreMes(numeroMes ?? 1)} de ${hoy.anio}.` : (fecha?.linea ?? fecha?.resumen ?? '');
const sitio = Astro.site ?? new URL(Astro.url.origin);
const urlFecha = fecha ? new URL(`/efemerides/${fecha.slug}/`, sitio).href : '';
const jsonLd =
	vista === 'mes'
		? itemListJsonLd(
				`${nombreMes(numeroMes ?? 1)} ${hoy.anio}`,
				delMes.map((item) => ({
					name: item.nombre,
					url: new URL(`/efemerides/${item.slug}/`, sitio).href,
				})),
			)
		: fecha
			? eventoEfemeride({
					nombre: fecha.nombre,
					descripcion: fecha.resumen,
					url: urlFecha,
					sitio: new URL('/', sitio).href,
					inicio: proxima ? isoFecha(proxima.anio, proxima.mes, proxima.dia) : null,
					migas: [
						{ name: 'Inicio', url: new URL('/', sitio).href },
						{ name: 'Efemérides', url: new URL('/efemerides/', sitio).href },
						...(mesFicha ? [{ name: nombreMes(mesFicha), url: new URL(`/efemerides/${slugDeMes(mesFicha)}/`, sitio).href }] : []),
						{ name: fecha.nombre, url: urlFecha },
					],
				})
			: undefined;
---

<BaseLayout title={`${titulo} | Aulita`} description={descripcion} jsonLd={jsonLd}>
	{
		vista === 'mes' ? (
			<div class="mx-auto max-w-6xl px-4 py-8">
				<Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Efemérides', href: '/efemerides/' }, { label: nombreMes(numeroMes ?? 1) }]} />
				<h1 class="mt-4 text-3xl font-bold tracking-tight text-azul sm:text-4xl">{nombreMes(numeroMes ?? 1)} {hoy.anio}</h1>
				<p class="mt-3 max-w-3xl text-base leading-relaxed text-muted">Fechas de este mes en el calendario {hoy.anio}.</p>
				<div class="mt-8">
					<BloqueMes titulo="Fechas" fechas={delMes} />
				</div>
				<nav class="mt-8 flex justify-between gap-4 text-sm font-medium" aria-label="Meses vecinos">
					<a class="text-celeste hover:underline" href={`/efemerides/${slugDeMes(anterior ?? 1)}/`}>
						← {nombreMes(anterior ?? 1)}
					</a>
					<a class="text-celeste hover:underline" href={`/efemerides/${slugDeMes(siguiente ?? 1)}/`}>
						{nombreMes(siguiente ?? 1)} →
					</a>
				</nav>
			</div>
		) : fecha ? (
			<article class="mx-auto max-w-6xl px-4 py-8">
				<Breadcrumbs
					items={[
						{ label: 'Inicio', href: '/' },
						{ label: 'Efemérides', href: '/efemerides/' },
						...(mesFicha ? [{ label: nombreMes(mesFicha), href: `/efemerides/${slugDeMes(mesFicha)}/` }] : []),
						{ label: fecha.nombre },
					]}
				/>
				<p class="mt-4 text-sm font-medium text-celeste">{etiquetaFecha(fecha.dia, fecha.mes, fecha.nombre)}</p>
				{fecha.dia == null && proxima ? <p class="mt-2 text-sm font-medium text-celeste">Próxima fecha: {textoFecha(proxima.dia, proxima.mes, proxima.anio)}</p> : null}
				<div class="mt-3 flex flex-wrap gap-2">
					<span class="inline-flex rounded-md border border-borde bg-white px-2 py-1 text-xs font-medium text-azul">{nombreTipo(fecha.tipo)}</span>
					{fecha.feriado.es ? (
						<span class="inline-flex rounded-md bg-celeste px-2 py-1 text-xs font-semibold text-white">Feriado {nombreRegla(fecha.feriado.regla)}</span>
					) : null}
				</div>
				{proxima?.nota ? <p class="mt-2 text-sm text-muted">{proxima.nota}</p> : null}
				<h1 class="mt-3 text-3xl font-bold tracking-tight text-azul sm:text-4xl">{fecha.nombre}</h1>
				<p class="mt-4 max-w-3xl text-base leading-relaxed text-texto">{fecha.resumen}</p>

				<section class="mt-8">
					<h2 class="text-xl font-bold text-azul">Recursos</h2>
					<ul class="mt-3 flex flex-wrap gap-2 text-sm">
						<li>
							<a class="inline-flex rounded-control border border-borde bg-white px-3 py-2 text-celeste hover:border-celeste" href={`/sopa-de-letras/?e=${fecha.slug}`}>
								Sopa de letras
							</a>
						</li>
						<li>
							<a class="inline-flex rounded-control border border-borde bg-white px-3 py-2 text-celeste hover:border-celeste" href={`/crucigrama-proceres/?e=${fecha.slug}`}>
								Crucigrama
							</a>
						</li>
						<li>
							<a class="inline-flex rounded-control border border-borde bg-white px-3 py-2 text-celeste hover:border-celeste" href={`/laminas/?e=${fecha.slug}`}>
								Láminas
							</a>
						</li>
					</ul>
				</section>

				<section class="mt-10">
					<h2 class="text-xl font-bold text-azul">Láminas para esta fecha</h2>
					{laminas.length === 0 ? (
						<p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
							Todavía no hay láminas publicadas para esta fecha.{' '}
							<a class="text-celeste hover:underline" href="/laminas/">Ver todas las láminas</a>.
						</p>
					) : (
						<ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{laminas.map((lamina) => (
								<li>
									<TarjetaLamina lamina={lamina} />
								</li>
							))}
						</ul>
					)}
				</section>

				{cercanas.length > 0 ? (
					<section class="mt-10">
						<h2 class="text-xl font-bold text-azul">Fechas cercanas</h2>
						<ul class="mt-3 space-y-2 text-sm">
							{cercanas.map((item) => (
								<li>
									<a class="text-celeste hover:underline" href={`/efemerides/${item.slug}/`}>
										{textoFecha(item.dia, item.mes, item.anio)} · {item.nombre}
									</a>
								</li>
							))}
						</ul>
					</section>
				) : null}

				<section class="mt-10">
					<h2 class="text-xl font-bold text-azul">Fuentes</h2>
					<ul class="mt-3 space-y-2 text-sm">
						{fecha.fuentes.map((fuente) => (
							<li>
								<a class="break-all text-celeste hover:underline" href={fuente} rel="noopener noreferrer">
									{fuente}
								</a>
							</li>
						))}
					</ul>
				</section>
			</article>
		) : null
	}
</BaseLayout>
