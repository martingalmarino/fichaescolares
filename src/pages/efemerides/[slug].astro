---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TarjetaLamina from '../../components/TarjetaLamina.astro';
import { efemerides, etiquetaFecha } from '../../data/efemerides';
import { laminasDeFecha } from '../../data/laminas';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	return efemerides.map((fecha) => ({
		params: { slug: fecha.slug },
		props: { slug: fecha.slug },
	}));
}

interface Props {
	slug: string;
}

const fecha = efemerides.find((item) => item.slug === Astro.props.slug);
if (!fecha) throw new Error(`Efeméride desconocida: ${Astro.props.slug}`);
const laminas = laminasDeFecha(fecha.dia, fecha.mes);
const etiqueta = etiquetaFecha(fecha.dia, fecha.mes, fecha.nombre);
---

<BaseLayout title={`${fecha.nombre} | Fichas Patrias`} description={fecha.linea}>
	<article class="mx-auto max-w-6xl px-4 py-8">
		<Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Efemérides', href: '/#efemerides' }, { label: fecha.nombre }]} />
		<p class="mt-4 text-sm font-medium text-celeste">{etiqueta}</p>
		<h1 class="mt-2 text-3xl font-bold tracking-tight text-azul sm:text-4xl">{fecha.nombre}</h1>
		<p class="mt-4 max-w-3xl text-base leading-relaxed text-texto">{fecha.resumen}</p>
		<p class="mt-4 text-sm">
			<a class="text-celeste hover:underline" href={`/sopa-de-letras/?e=${fecha.slug}`}>Armar la sopa de letras de esta fecha</a>
		</p>

		<section class="mt-10">
			<h2 class="text-xl font-bold text-azul">Láminas para esta fecha</h2>
			{
				laminas.length === 0 ? (
					<p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
						Todavía no hay láminas publicadas para esta fecha.{' '}
						<a class="text-celeste hover:underline" href="/laminas/">Ver todas las láminas</a>.
					</p>
				) : (
					<ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
						{laminas.map((lamina) => (
							<li>
								<TarjetaLamina lamina={lamina} />
							</li>
						))}
					</ul>
				)
			}
		</section>
	</article>
</BaseLayout>
