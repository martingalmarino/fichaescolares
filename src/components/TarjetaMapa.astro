---
import { archivoMapa, nombreTipo, type MapaIgn } from '../data/mapas';

interface Props {
	mapa: MapaIgn;
}

const { mapa } = Astro.props;
---

<a class="flex h-full flex-col rounded-card border border-borde bg-white p-3 shadow-card transition hover:border-celeste" href={`/mapas/${mapa.slug}/`}>
	<img
		src={archivoMapa(mapa.slug, 'thumb')}
		alt={mapa.titulo}
		width={mapa.thumbAncho}
		height={mapa.thumbAlto}
		loading="lazy"
		decoding="async"
		class="h-auto w-full bg-white object-contain"
		style={`aspect-ratio: ${mapa.thumbAncho} / ${mapa.thumbAlto}`}
	/>
	<span class="mt-3 text-sm font-semibold leading-snug text-azul">{mapa.titulo}</span>
	<span class="mt-1 text-xs font-medium text-muted">{nombreTipo(mapa.tipo)} · {mapa.tamano} · {mapa.gradoSugerido}</span>
</a>
