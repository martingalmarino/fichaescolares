---
import { chipFecha } from '../lib/calendario';

interface FechaFila {
	slug: string;
	nombre: string;
	dia: number;
	mes: number;
	nota: string | null;
}

interface Props {
	titulo: string;
	href?: string;
	id?: string;
	fechas: FechaFila[];
}

const { titulo, href, id, fechas } = Astro.props;
---

<section id={id} class="scroll-mt-6">
	<div class="flex items-baseline justify-between gap-3">
		<h2 class="text-xl font-bold text-azul">
			{href ? <a class="hover:underline" href={href}>{titulo}</a> : titulo}
		</h2>
		{
			href ? (
				<a class="text-sm font-medium text-celeste hover:underline" href={href}>
					Ver el mes
				</a>
			) : null
		}
	</div>
	{
		fechas.length === 0 ? (
			<p class="mt-3 text-sm leading-relaxed text-muted">Este mes no tiene fechas en el calendario.</p>
		) : (
			<ul class="mt-3 divide-y divide-borde border-y border-borde">
				{fechas.map((fecha) => (
					<li>
						<a class="flex items-start gap-3 py-3 hover:text-celeste" href={`/efemerides/${fecha.slug}/`}>
							<span class="inline-flex w-16 shrink-0 justify-center rounded-md bg-celeste px-2 py-1 text-[11px] font-semibold tracking-wide text-white">
								{chipFecha(fecha.dia, fecha.mes)}
							</span>
							<span>
								<span class="block text-sm font-semibold leading-snug text-azul">{fecha.nombre}</span>
								{fecha.nota ? <span class="mt-0.5 block text-sm text-muted">{fecha.nota}</span> : null}
							</span>
						</a>
					</li>
				))}
			</ul>
		)
	}
</section>
