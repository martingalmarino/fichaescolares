---
import Logo from './Logo.astro';

const antes = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Generadores', href: '/#generadores' },
];
const despues = [
	{ label: 'Efemérides', href: '/#efemerides' },
	{ label: 'Provincias', href: '/provincias/' },
	{ label: 'Guía para el aula', href: '/guia-para-el-aula/' },
];
---

<header class="border-b border-borde bg-white">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between"
	>
		<a href="/" class="flex items-center gap-2.5">
			<Logo />
			<span class="text-lg font-semibold tracking-tight text-azul">Fichas Patrias</span>
		</a>
		<nav class="flex flex-wrap items-center gap-x-1 gap-y-0.5 text-sm" aria-label="Principal">
			{
				antes.map((link) => (
					<a href={link.href} class="inline-flex min-h-11 items-center rounded-md px-2 text-muted transition-colors hover:text-azul">
						{link.label}
					</a>
				))
			}
			<details class="relative">
				<summary class="inline-flex min-h-11 cursor-pointer items-center rounded-md px-2 text-muted transition-colors hover:text-azul">
					Imprimibles
				</summary>
				<div class="z-20 min-w-56 rounded-card border border-borde bg-white p-2 shadow-card sm:absolute sm:left-0 sm:top-full">
					<a class="flex min-h-11 items-center rounded-md px-3 text-sm text-azul hover:bg-celeste-50" href="/laminas/">
						Láminas para colorear
					</a>
				</div>
			</details>
			{
				despues.map((link) => (
					<a href={link.href} class="inline-flex min-h-11 items-center rounded-md px-2 text-muted transition-colors hover:text-azul">
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</header>
