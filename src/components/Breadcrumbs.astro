---
interface Item {
	label: string;
	href?: string;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
---

<nav class="no-print text-sm text-muted" aria-label="Miga de pan">
	<ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
		{
			items.map((item, index) => (
				<li class="flex items-center gap-1.5">
					{index > 0 && <span aria-hidden="true">›</span>}
					{item.href ? (
						<a href={item.href} class="hover:text-azul">
							{item.label}
						</a>
					) : (
						<span class="text-texto">{item.label}</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
