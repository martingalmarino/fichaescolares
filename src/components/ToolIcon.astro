---
interface Props {
	name: 'sopa' | 'crucigrama' | 'caligrafia' | 'provincia' | 'laminas' | 'mapas' | 'tablas' | 'etiquetas' | 'planificador' | 'agenda' | 'planificacion' | 'asistencia' | 'tarjetas';
}

const { name } = Astro.props;
---

<span
	class="flex size-10 items-center justify-center rounded-control bg-celeste-50 text-celeste"
	aria-hidden="true"
>
	{
		name === 'sopa' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<path
					d="M4 4h4.5v4.5H4V4Zm11.5 0H20v4.5h-4.5V4ZM4 15.5h4.5V20H4v-4.5Zm11.5 0H20V20h-4.5v-4.5ZM9.75 9.75h4.5v4.5h-4.5v-4.5Z"
					stroke="currentColor"
					stroke-width="1.6"
				/>
			</svg>
		)
	}
	{
		name === 'crucigrama' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<path
					d="M4 8h7V4h4v4h5v4h-5v8h-4v-8H4V8Z"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linejoin="round"
				/>
			</svg>
		)
	}
	{
		name === 'caligrafia' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<path
					d="M4 19c2.2-4 4.2-8.5 5.2-13.2.2-.8 1.3-.8 1.5 0C12 12 15 16.5 20 19"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
				/>
				<path d="M8 19h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
			</svg>
		)
	}
	{
		name === 'provincia' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<path
					d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10Z"
					stroke="currentColor"
					stroke-width="1.6"
				/>
				<circle cx="12" cy="11" r="1.8" fill="currentColor" />
			</svg>
		)
	}
	{
		name === 'laminas' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<rect
					x="4"
					y="5"
					width="16"
					height="14"
					rx="2"
					stroke="currentColor"
					stroke-width="1.6"
				/>
				<circle cx="9" cy="10" r="1.4" fill="currentColor" />
				<path
					d="M4 16.5 9 13l3 2.5 3-2 5 3"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linejoin="round"
				/>
			</svg>
		)
	}
	{
		name === 'mapas' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<path
					d="M9 4.5 4 6.5v13l5-2 6 2 5-2v-13l-5 2-6-2Z"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linejoin="round"
				/>
				<path d="M9 4.5v13M15 6.5v13" stroke="currentColor" stroke-width="1.6" />
			</svg>
		)
	}
	{
		name === 'etiquetas' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<rect x="3" y="6" width="18" height="12" rx="1.5" stroke="currentColor" stroke-width="1.6" stroke-dasharray="2.2 1.6" />
				<path d="M7 12h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
			</svg>
		)
	}
	{
		name === 'asistencia' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<rect x="5" y="3.5" width="14" height="17" rx="1.5" stroke="currentColor" stroke-width="1.6" />
				<path d="M8.5 9.5l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
				<path d="M8.5 16h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
			</svg>
		)
	}
	{
		name === 'planificacion' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<rect x="3.5" y="4.5" width="17" height="15" rx="1.5" stroke="currentColor" stroke-width="1.6" />
				<path d="M3.5 9h17M9 9v10.5" stroke="currentColor" stroke-width="1.6" />
			</svg>
		)
	}
	{
		name === 'agenda' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<path d="M8 4.5h10.5A1.5 1.5 0 0 1 20 6v13a1.5 1.5 0 0 1-1.5 1.5H8" stroke="currentColor" stroke-width="1.6" />
				<path d="M8 4.5v16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
				<path d="M5 8h3M5 12h3M5 16h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
				<path d="M11 9.5h6M11 13h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
			</svg>
		)
	}
	{
		name === 'planificador' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.6" />
				<path d="M8 3.5v3M16 3.5v3M4 9.5h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
				<path d="M8 14h3M13 14h3M8 17h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
			</svg>
		)
	}
	{
		name === 'tarjetas' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<rect x="7.5" y="3.5" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.6" />
				<rect x="4.5" y="8.5" width="12" height="12" rx="1.5" stroke="currentColor" stroke-width="1.6" />
				<path d="M8 14h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
			</svg>
		)
	}
	{
		name === 'tablas' && (
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="none">
				<circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6" />
				<path
					d="M12 8v8M8 12h8"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
				/>
			</svg>
		)
	}
</span>
