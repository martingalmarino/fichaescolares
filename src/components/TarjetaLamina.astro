---
import { nombreDificultad, type Lamina } from '../data/laminas';

interface Props {
	lamina: Lamina;
}

const { lamina } = Astro.props;
---

<a class="flex h-full flex-col rounded-card border border-borde bg-white p-3 shadow-card transition hover:border-celeste" href={`/laminas/${lamina.slug}/`}>
	<img
		src={lamina.svg}
		alt={lamina.alt}
		width={lamina.ancho}
		height={lamina.alto}
		loading="lazy"
		decoding="async"
		class="h-auto w-full object-contain"
		style={`aspect-ratio: ${lamina.ancho} / ${lamina.alto}`}
	/>
	<span class="mt-3 text-sm font-semibold leading-snug text-azul">{lamina.titulo}</span>
	<span class="mt-1 text-xs font-medium text-muted">{nombreDificultad(lamina.dificultad)}</span>
</a>
