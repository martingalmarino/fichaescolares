---
interface Pregunta {
	q: string;
	a: string;
}

interface Props {
	titulo?: string;
	preguntas: Pregunta[];
	abrirPrimera?: boolean;
}

const { titulo = 'Preguntas frecuentes', preguntas, abrirPrimera = false } = Astro.props;
---

<section class="mt-12" aria-labelledby="faq-titulo">
	<h2 id="faq-titulo" class="text-2xl font-bold tracking-tight text-azul">{titulo}</h2>
	<div class="mt-6 overflow-hidden rounded-card border border-borde bg-white">
		{
			preguntas.map((item, indice) => (
				<details class="group border-b border-borde last:border-b-0" data-q={item.q} open={abrirPrimera && indice === 0}>
					<summary class="flex cursor-pointer items-center gap-3 px-4 py-4 text-sm font-semibold text-azul sm:text-base">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" class="size-3.5 shrink-0 text-muted transition-transform group-open:rotate-90" aria-hidden="true">
							<path d="M6 3.5 11 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						{item.q}
					</summary>
					<p class="px-4 pb-4 pl-10 text-sm leading-relaxed text-muted" set:html={item.a} />
				</details>
			))
		}
	</div>
</section>
