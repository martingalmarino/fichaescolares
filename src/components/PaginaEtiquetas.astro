---
import '@fontsource/andika/latin-400.css';
import '@fontsource/playwrite-ar/latin-400.css';
import Breadcrumbs from './Breadcrumbs.astro';
import Preguntas from './Preguntas.astro';
import EtiquetasGenerator from '../islands/EtiquetasGenerator';
import type { PresetEtiquetas } from '../lib/etiquetas';

interface Enlace {
	href: string;
	label: string;
}

interface Paso {
	name: string;
	text: string;
}

interface Props {
	h1: string;
	resumen: string;
	preset: PresetEtiquetas;
	migas: { label: string; href?: string }[];
	parrafos: string[];
	preguntas: { q: string; a: string }[];
	enlaces: Enlace[];
	pasos?: readonly Paso[];
}

const { h1, resumen, preset, migas, parrafos, preguntas, enlaces, pasos } = Astro.props;
---

<article class="mx-auto max-w-7xl px-4 py-8">
	<Breadcrumbs items={migas} />
	<h1 class="no-print mt-4 text-3xl font-bold tracking-tight text-azul sm:text-4xl">{h1}</h1>
	<p class="no-print mt-3 max-w-3xl text-base leading-relaxed text-muted">{resumen}</p>
	<div class="mt-6">
		<EtiquetasGenerator client:visible preset={preset} />
	</div>
	<div class="no-print mx-auto mt-12 max-w-3xl text-base leading-relaxed">
		{
			pasos && (
				<ol class="list-decimal space-y-2 pl-5">
					{pasos.map((paso) => (
						<li>
							<span class="font-semibold text-azul">{paso.name}. </span>
							{paso.text}
						</li>
					))}
				</ol>
			)
		}
		{
			parrafos.map((parrafo) => (
				<p class="mt-4">{parrafo}</p>
			))
		}
		<h2 class="mt-8 text-2xl font-bold text-azul">Seguir armando</h2>
		<ul class="mt-3 list-disc space-y-2 pl-5">
			{
				enlaces.map((enlace) => (
					<li>
						<a class="text-celeste underline" href={enlace.href}>
							{enlace.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
	<div class="no-print mx-auto max-w-3xl">
		<Preguntas preguntas={preguntas} />
	</div>
</article>
