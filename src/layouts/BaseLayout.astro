---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter700 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
import '../styles/global.css';
import '../styles/print.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Consentimiento from '../islands/Consentimiento';

interface Props {
	title: string;
	description: string;
	keywords?: string;
	image?: string;
	jsonLd?: unknown;
	noindex?: boolean;
}

const { title, description, keywords, image = '/og/home.svg', jsonLd, noindex = false } = Astro.props;
const sitio = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, sitio).href;
const imagen = new URL(image, sitio).href;
const gaId = import.meta.env.PUBLIC_GA_ID ?? '';
const adsense = import.meta.env.PUBLIC_ADSENSE_CLIENT || 'ca-pub-6771833588582297';

const mision = 'Fichas, mapas y efemérides escolares argentinas, gratis y listas para imprimir en A4. Para docentes y familias.';
const sitioLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': 'https://www.aulita.com.ar/#website',
			name: 'Aulita',
			url: 'https://www.aulita.com.ar/',
			inLanguage: 'es-AR',
			description: mision,
			publisher: { '@id': 'https://www.aulita.com.ar/#organization' },
		},
		{
			'@type': 'Organization',
			'@id': 'https://www.aulita.com.ar/#organization',
			name: 'Aulita',
			url: 'https://www.aulita.com.ar/',
			description: mision,
			logo: {
				'@type': 'ImageObject',
				url: 'https://www.aulita.com.ar/favicon.svg',
			},
		},
	],
};
---

<!doctype html>
<html lang="es-AR">
	<head>
		<!-- Google Tag Manager -->
		<script is:inline>
			(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
			new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
			})(window,document,'script','dataLayer','GTM-TL387NWZ');
		</script>
		<!-- End Google Tag Manager -->
		<link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={inter700} as="font" type="font/woff2" crossorigin />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="google-site-verification" content="FgKMay3SX1jirsCErPropAS-F33MoPLQKFuyOJizKcY" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:site_name" content="Aulita" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imagen} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imagen} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="manifest" href="/site.webmanifest" />
		<title>{title}</title>
		<slot name="head" />
		{
			adsense && (
				<script
					is:inline
					async
					src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense}`}
					crossorigin="anonymous"
				/>
			)
		}
		<script type="application/ld+json" set:html={JSON.stringify(sitioLd)} />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<script>
			document.addEventListener(
				'toggle',
				(event) => {
					const details = event.target;
					if (!(details instanceof HTMLDetailsElement) || !details.open) return;
					const pregunta = details.dataset.q;
					if (!pregunta || localStorage.getItem('fp-consent') !== 'granted' || typeof window.gtag !== 'function') return;
					window.gtag('event', 'faq_open', { q: pregunta });
				},
				true,
			);
		</script>
	</head>
	<body class="min-h-screen bg-bg font-sans text-texto antialiased">
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TL387NWZ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<Consentimiento client:load gaId={gaId} />
	</body>
</html>
